<properties>
	
		<property name="addMeeting">
		<![CDATA[
			insert into  t_meeting_content (meeting_id,attach_id,create_date,creater,del_flag,last_modifier,last_modify_date,meeting_address,meeting_content,meeting_start_data,meeting_end_data,meeting_status,organizer,release_date,title) values(#[meetingId],#[attachId],#[createDate],#[creater],#[delFlag],#[lastModifier],#[lastModifyDate],#[meetingAddress],#[meetingContent],#[meetingStartData],#[meetingEndData],#[meetingStatus],#[organizer],#[releaseDate],#[title])
		]]>
	</property>
		<property name="deleteByKey">
		<![CDATA[
			delete from t_meeting_content where meeting_id=?
		]]>
	</property>
		<property name="updateMeeting">
		<![CDATA[
			update t_meeting_content set meeting_id=#[meetingId],attach_id=#[attachId],create_date=#[createDate],creater=#[creater],del_flag=#[delFlag],last_modifier=#[lastModifier],last_modify_date=#[lastModifyDate],meeting_address=#[meetingAddress],meeting_content=#[meetingContent],meeting_Start_Data=#[meetingStartData],meeting_end_Data=#[meetingEndData],meeting_status=#[meetingStatus],organizer=#[organizer],release_date=#[releaseDate],title=#[title] where meeting_id=#[meetingId]
		]]>
	</property>
		<property name="selectById">
		<![CDATA[
			select * from t_meeting_content where meeting_id=?
		]]>
	</property>
		<property name="queryListMeeting">
		<![CDATA[
			select * from t_meeting_content where 1=1

			#if($meetingAddress && !$meetingAddress.equals(""))
				and meeting_address like #[meetingAddress]		
			#end
			#if($title && !$title.equals(""))
				and title like #[title]		
			#end

			#if($searchword && !$searchword.equals(""))
				and (title like #[searchword] OR meeting_address like #[searchword])
			#end

			order by release_Date desc
			
		]]>
	</property>

	<property name="queryListInfoMeetingByTopTen">
		<![CDATA[
			select a.* from t_meeting_content a
			where a.meeting_status ='1'   order by a.release_date desc  limit 9
		]]>
	</property>

</properties>