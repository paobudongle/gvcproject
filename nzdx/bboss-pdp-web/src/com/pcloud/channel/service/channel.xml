<properties>
	
		<property name="addChannel">
		<![CDATA[
			insert into t_cms_channel (channel_id,create_date,creater,del_flag,description,has_content,is_blank_open,is_display,keywrods,last_modifier,last_modify_date,order_no,pid,sort_title,title,tpl_content) values(#[channelId],#[createDate],#[creater],#[delFlag],#[description],#[hasContent],#[isBlankOpen],#[isDisplay],#[keywrods],#[lastModifier],#[lastModifyDate],#[orderNo],#[pid],#[sortTitle],#[title],#[tplContent])
		]]>
	</property>
		<property name="deleteByKey">
		<![CDATA[
			delete from t_cms_channel where channel_id=?
		]]>
	</property>
		<property name="updateChannel">
		<![CDATA[
			update t_cms_channel set channel_id=#[channelId],create_date=#[createDate],creater=#[creater],del_flag=#[delFlag],description=#[description],has_content=#[hasContent],is_blank_open=#[isBlankOpen],is_display=#[isDisplay],keywrods=#[keywrods],last_modifier=#[lastModifier],last_modify_date=#[lastModifyDate],order_no=#[orderNo],pid=#[pid],sort_title=#[sortTitle],title=#[title],tpl_content=#[tplContent] where channel_id=#[channelId]
		]]>
	</property>
		<property name="selectById">
		<![CDATA[
			select * from t_cms_channel where channel_id=?
		]]>
	</property>

	<property name="queryListChannel">
		<![CDATA[
			select * from t_cms_channel where 1=1 and pid <> '0'
			#if($title && !$title.equals(""))
				and title like #[title]		
			#end

			order by order_no
			
		]]>
	</property>


	<property name="getChildren">
		<![CDATA[
				SELECT *
				  FROM t_cms_channel
				 WHERE pid = ?

				order by order_no
		]]>
	</property>
	</properties>