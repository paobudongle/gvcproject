<properties>
	
		<property name="addAdvertise">
		<![CDATA[
			insert into t_advertise_content (advertise_id,advertise_company,advertise_content,advertise_position,advertise_status,attach_id,create_date,creater,del_flag,last_modifier,last_modify_date,release_date,work_address,work_wage) values(#[advertiseId],#[advertiseCompany],#[advertiseContent],#[advertisePosition],#[advertiseStatus],#[attachId],#[createDate],#[creater],#[delFlag],#[lastModifier],#[lastModifyDate],#[releaseDate],#[workAddress],#[workWage])
		]]>
	</property>
		<property name="deleteByKey">
		<![CDATA[
			delete from t_advertise_content where advertise_id=?
		]]>
	</property>
		<property name="updateAdvertise">
		<![CDATA[
			update t_advertise_content set advertise_id=#[advertiseId],advertise_company=#[advertiseCompany],advertise_content=#[advertiseContent],advertise_position=#[advertisePosition],advertise_status=#[advertiseStatus],attach_id=#[attachId],create_date=#[createDate],creater=#[creater],del_flag=#[delFlag],last_modifier=#[lastModifier],last_modify_date=#[lastModifyDate],release_date=#[releaseDate],work_address=#[workAddress],work_wage=#[workWage] where advertise_id=#[advertiseId]
		]]>
	</property>
		<property name="selectById">
		<![CDATA[
			select * from t_advertise_content where advertise_id=?
		]]>
	</property>
		<property name="queryListAdvertise">
		<![CDATA[
			select * from t_advertise_content where 1=1
			#if($advertisePosition && !$advertisePosition.equals(""))
				and advertise_position like #[advertisePosition]		
			#end

			#if($workAddress && !$workAddress.equals(""))
				and work_address like #[workAddress]		
			#end
			#if($searchword && !$searchword.equals(""))
				and (work_address like  #[searchword] OR advertise_position like #[searchword] )
			#end
			order by release_Date desc
		]]>
	</property>



	<property name="queryListInfoAdvertiseByTopTen">
		<![CDATA[
			select a.* from t_advertise_content a
			where a.advertise_status ='1'   order by a.release_date desc  limit 9
		]]>
	</property>


</properties>