<properties>
	
		<property name="addModelResource">
		<![CDATA[
			insert into t_model_resource (id,blongs_model,description,diffic_level,download_count,is_charge,parent_id,soucre_path,source_icon,source_name,source_type,suffix,time_length,update_date,upload_time,upload_user,view_count,file_size) values(#[id],#[blongsModel],#[description],#[difficLevel],#[downloadCount],#[isCharge],#[parentId],#[soucrePath],#[sourceIcon],#[sourceName],#[sourceType],#[suffix],#[timeLength],#[updateDate],#[uploadTime],#[uploadUser],#[viewCount],#[fileSize])
		]]>
	</property>
		<property name="deleteByKey">
		<![CDATA[
			delete from t_model_resource where id=?
		]]>
	</property>

	<property name="deleteByParentId">
		<![CDATA[
			delete from t_model_resource where parent_id=?
		]]>
	</property>

	<property name="updateModelResource">
		<![CDATA[
			update t_model_resource set id=#[id],blongs_model=#[blongsModel],description=#[description],diffic_level=#[difficLevel],download_count=#[downloadCount],is_charge=#[isCharge],parent_id=#[parentId],soucre_path=#[soucrePath],source_icon=#[sourceIcon],source_name=#[sourceName],source_type=#[sourceType],suffix=#[suffix],time_length=#[timeLength],update_date=#[updateDate],upload_time=#[uploadTime],upload_user=#[uploadUser],view_count=#[viewCount] where id=#[id]
		]]>
	</property>

	<property name="updateFrontModelResource">
		<![CDATA[
			update t_model_resource set id=#[id],blongs_model=#[blongsModel],description=#[description],diffic_level=#[difficLevel],is_charge=#[isCharge],parent_id=#[parentId],source_icon=#[sourceIcon],source_name=#[sourceName],source_type=#[sourceType] where id=#[id]
		]]>
	</property>


		<property name="selectById">
		<![CDATA[
			select * from t_model_resource where id=?
		]]>
	</property>

	<property name="queryListModelResource">
		<![CDATA[

			SELECT
				*,
				(
					SELECT
						count(a.parent_id)
					FROM
						t_model_resource a
					WHERE
						a.parent_id = b.id
				) cdnum
			FROM
				t_model_resource b
			WHERE
				b.parent_id = 0

			#if($sourceName && !$sourceName.equals(""))
				and b.source_name like #[sourceName]
			#end
			order by update_date desc
			
		]]>
	</property>

	<property name="getChildren">
		<![CDATA[
			select * from t_model_resource where 1=1

			#if($parentId && !$parentId.equals(""))
				and parent_id = #[parentId]
			#end

		]]>
	</property>

	<property name="queryChildrenListInfoModelResources">
		<![CDATA[
			select * from t_model_resource where 1=1 and soucre_path is not null

			#if($parentId && !$parentId.equals(""))
				and parent_id = #[parentId]
			#end

			#if($blongsModel && !$blongsModel.equals(""))
				and blongs_model = #[blongsModel]
			#end

			#if($sourceType && !$sourceType.equals(""))
				and source_Type = #[sourceType]
			#end

			#if($difficLevel && !$difficLevel.equals(""))
				and diffic_Level = #[difficLevel]
			#end
			#if($isCharge && !$isCharge.equals(""))
				and is_Charge = #[isCharge]
			#end
			#if($newHot && !$newHot.equals(""))
				#if($newHot.equals("0"))
				  order by update_date desc
				#end
				#if($newHot.equals("1"))
				  order by view_count desc
				#end
			#end
			#if(!$newHot||$newHot.equals(""))
				order by  upload_time desc
			#end

		]]>
	</property>

	<property name="deleteModelResourceFile">
		<![CDATA[
			delete from t_model_resource where 1=1

			#if($parentId && !$parentId.equals(""))
				and parent_id = #[parentId]
			#end

			#if($sourceName && !$sourceName.equals(""))
				and source_name like #[sourceName]
			#end

		]]>
	</property>

	<property name="updateBatchModelResource">
		<![CDATA[
			update t_model_resource set time_length=#[timeLength], description=#[description],source_name=#[sourceName] where id=#[id]
		]]>
	</property>

	<property name="downCount">
		<![CDATA[
			update t_model_resource t set t.download_count = t.download_count+1, t.view_count = t.view_count+1 where t.id = ?
		]]>
	</property>

	<property name="updateParentInfo">
		<![CDATA[
			update t_model_resource set description=#[description],source_name=#[sourceName],
			blongs_model=#[blongsModel],diffic_level=#[difficLevel],is_charge=#[isCharge] where id=#[id]
		]]>
	</property>

	<property name="updateChildInfo">
		<![CDATA[
			update t_model_resource set blongs_model=#[blongsModel],diffic_level=#[difficLevel],is_charge=#[isCharge] where parent_id=#[id]
		]]>
	</property>

	<property name="getCommentList">
		<![CDATA[
			select * from t_resorce_comment where resource_id = #[resourceId] order by comment_date desc



		]]>
	</property>

	<property name="addResourceComment">
		<![CDATA[
			INSERT INTO t_resorce_comment VALUES (#[id], #[comment], #[star], #[resourceId], #[commentUser], #[commentDate]);
		]]>
	</property>
	<property name="getCommentInfo">
		<![CDATA[
			select * from t_resorce_comment where resource_id = #[resourceId] and comment_user = #[commentUser]
		]]>
	</property>


	</properties>